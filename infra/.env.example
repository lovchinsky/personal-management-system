# An environment template. Copy it to `infra/.env.local` on the local machine or
# `infra/.env.prod` on the server, with permissions 0600; neither file is committed to git. Every
# random secret below is `openssl rand -hex 32`, unless a comment says otherwise.

# Database passwords. The passwords of the App and GBrain roles are exactly 64 hexadecimal
# characters: they appear in the database URLs, and `postgres/init.sql` accepts nothing else.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
GBRAIN_DB_PASSWORD=
GBRAIN_ADMIN_BOOTSTRAP_TOKEN=

# GBrain knowledge repository. Compose resolves a relative path against `infra/`.
#   local:      ../../gbrain-repo — the `gbrain-repo` directory next to the clone of
#               `personal-management-system`
#   production: /srv/gbrain-repo
# The directory is a git repository that uid 1000 can write to: the user of the GBrain image.
GBRAIN_REPO_PATH=

# GBrain release: a pinned baseline, the same for both environments
GBRAIN_REF=43597b19e50a3abf56409337f248f7966860293c
GBRAIN_IMAGE_TAG=0.48.5.0
# The language of GBrain's keyword search (ADR 0050): a built-in configuration of Postgres
# (english, german, spanish, …) or the lowercase name of a hunspell dictionary placed in
# postgres/dictionaries/ (uk_UA.dic and uk_UA.aff give uk_ua). It is part of the stored data's
# configuration: a change after the first start means a reindex (RUNBOOK §19).
GBRAIN_FTS_LANGUAGE=english
# The embedding model and the vector width are part of the stored data's configuration; the
# defaults are voyage:voyage-4 and 1024. They change only together with an embedding migration
# (RUNBOOK §18).
# GBRAIN_EMBEDDING_MODEL=voyage:voyage-4
# GBRAIN_EMBEDDING_DIMENSIONS=1024

# The installation's time zone: the day of the daily run limit starts in it, and quiet hours run
# in it. The container runs in UTC, so relying on its locale would mean counting the day in a
# place other than where the person lives. The default is Europe/Kyiv.
APP_TIMEZONE=Europe/Kyiv

# The language in which the App itself writes to the person: system messages, buttons and channel
# replies, consent pages (ADR 0042). The model writes in the person's language and does not read
# this variable. One of the languages that have a catalog: uk or en. The default is en.
APP_LANGUAGE=en

# The grammatical gender the App (in the Ukrainian catalog) and the model use when they address
# the owner in the informal second person (“ти”, ADR 0046): masculine (“ти схвалив”,
# ‘you approved’), feminine (“ти схвалила”) or neutral, meaning sentences without gender forms.
# The default is neutral: gender is not guessed.
APP_OWNER_GENDER=

# The assistant name, for example Alex (ADR 0049). Use the same name for the bot in BotFather and
# for the integration in the Notion developer portal: the App does not rename them. The model
# knows the name so that it can tell when you are addressing it. No longer than 64 characters.
# Empty means an assistant without a name: then you name the bot and the integration Personal
# Management System.
APP_ASSISTANT_NAME=

# The grammatical gender the assistant uses when it speaks of itself in Ukrainian (ADR 0046):
# masculine (“я переглянув”, ‘I reviewed’), feminine (“я переглянула”) or neutral, meaning
# sentences without gender forms. The default is neutral.
APP_ASSISTANT_GENDER=

# The public base URL of the App. Locally, the address of the dev tunnel; in production,
# https://<APP_DOMAIN>. The operator's value: the App does not read it, and Compose does not pass
# it to the App. The RUNBOOK derives from it the addresses the Telegram and Notion webhooks are
# registered with: a new address means registering both again.
APP_PUBLIC_BASE_URL=

# The encryption key for `connector_credentials`. Losing the key means authorizing the connectors
# again (RUNBOOK §6.3).
APP_ENCRYPTION_KEY=

# Quiet hours: during them the phone stays silent, and a message waits in the queue until morning.
# They silence what the system decided to say on its own; snoozes and deadlines get through.
# Quiet hours do not stop a run: they apply only to delivery.
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=23:00
QUIET_HOURS_END=08:00

# Scheduled reviews, in the wall-clock time of APP_TIMEZONE (ADR 0036). Grammar:
# `daily HH:MM`, `weekly <mon…sun> HH:MM`, `monthly <1–28> HH:MM`,
# `quarterly <1–28> HH:MM` or `off`. Empty means the default schedule:
# daily at 08:30, weekly on Sunday at 18:00, strategic on the 1st at 10:00,
# deep off. Without a delivery channel reviews are not scheduled at all.
# The template turns all four off: a new installation turns them on one at a time.
REVIEW_DAILY_CONTROL=off
REVIEW_WEEKLY_CONTROL=off
REVIEW_STRATEGIC=off
REVIEW_DEEP=off

# The delivery channel is an adapter of the notification port (ADR 0007). It is required for a
# working installation: without it reviews are not scheduled and notifications go to `failed`.
# Telegram does not sign the webhook, so inbound requests are protected by two independent checks:
# the header secret passed to setWebhook and the allowed chat.id.
# BotFather issues the token, `getUpdates` returns the chat.id; the webhook secret is random.
# `setWebhook` registers the webhook with this secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# App -> Claude: the token of the owner's own subscription from `claude setup-token`; it expires
# after one year. The App authenticates only with the owner's own subscription: there is no path
# through an API key.
CLAUDE_CODE_OAUTH_TOKEN=

# The App's client in GBrain: `gbrain auth register-client` issues it once, after the first
# startup of GBrain.
GBRAIN_CLIENT_ID=
GBRAIN_CLIENT_SECRET=

# App-owned Notion REST integration — deterministic credential.
# Separate from the Notion MCP OAuth state (INV-060): the MCP path uses the names NOTION_MCP_*.
# NOTION_API_VERSION is exactly the API version that the `@notionhq/client` SDK of the App image
# describes; any other value stops the App's startup.
# NOTION_API_TOKEN is the Internal Integration Secret of the owner's integration.
NOTION_API_TOKEN=
NOTION_API_VERSION=2025-09-03
# The Notion webhook signing key. The real `verification_token` comes only from the subscription,
# and that needs a running App, so until the subscription exists a random value goes here: without
# a value the App does not start. While there is no real value, Notion deliveries are rejected
# with 401.
NOTION_WEBHOOK_SECRET=
# The subscription provisioning window: it is turned on for the duration of one subscription and
# turned off again. Outside it the endpoint accepts nothing unsigned: whether a signature is
# needed is decided by this variable, not by the shape of the request body.
NOTION_WEBHOOK_AWAITING_VERIFICATION=false
# Where verification_token is written during provisioning. The default is a tmpfs in compose,
# which a restart erases; the App reads an empty value as the default.
NOTION_VERIFICATION_TOKEN_PATH=/run/app/verification_token

# Notion MCP OAuth is a credential separate from REST (INV-060). The hosted endpoint does not
# accept a bearer from an internal integration: only Authorization Code + PKCE.
# The App keeps the refresh state in `connector_credentials`, encrypted: the image is immutable
# and the disk does not survive a redeploy, so the grant state lives in the database.
# APP_ENCRYPTION_KEY encrypts it, like the rest of the connector credentials.
# The person runs Authorize once every 180 days.
NOTION_MCP_URL=https://mcp.notion.com/mcp
NOTION_MCP_REDIRECT_URI=http://localhost:8765/callback
# The name of the Notion MCP client on the consent page and among the workspace's connections;
# the default is “Personal Management System”.
# NOTION_MCP_CLIENT_NAME=Personal Management System

# The runner of App-triggered runs. When enabled, it turns evaluation windows, due continuations,
# Inbox items and channel messages into real model runs under the Skill, and it shares the plan
# quota with interactive work. When disabled, the origin rows wait in the queues without spending
# anything. The gate enables it itself, in its own container of the gate environment (ADR 0041).
RUNNER_ENABLED=false

# Background work: delivery, the approval executor, the run scheduler, maintenance.
# It runs by default. The gate does not touch it: the gate works in a separate environment with
# its own database (ADR 0041).
# WORKERS_ENABLED=true

# The public MCP addresses for the Chat path: `plugin/.mcp.json` substitutes them in the owner's
# Claude installation, and the installation's marketplace entry (`marketplace.example.json`)
# contains the same addresses. App runs do not go through them: they reach the App MCP over
# loopback and GBrain over the Compose network. The App reads APP_MCP_URL as the resource and
# issuer of its authorization server for the chat (together with APP_OAUTH_OWNER_PASSPHRASE).
# Locally, all three are set to the URL of the dev tunnel. The production server reads only
# APP_MCP_URL (https://<APP_DOMAIN>/mcp): the GBrain address there is set by compose.prod.yaml
# from GBRAIN_DOMAIN, so GBRAIN_PUBLIC_URL (https://<GBRAIN_DOMAIN>) and GBRAIN_MCP_URL
# (https://<GBRAIN_DOMAIN>/mcp) are empty on the server. GBRAIN_PUBLIC_URL is the address at
# which the MCP client sees GBrain; empty means http://localhost:3131. Only `plugin/.mcp.json` in
# Claude Code on the local machine reads GBRAIN_MCP_URL.
APP_MCP_URL=
# The owner passphrase on the OAuth consent page when Claude Code or claude.ai connects to the
# App MCP: no shorter than 32 characters, generated (`openssl rand -base64 32`). Without it the
# authorization server does not respond.
APP_OAUTH_OWNER_PASSPHRASE=
GBRAIN_PUBLIC_URL=
GBRAIN_MCP_URL=

# GBrain retrieval baseline
VOYAGE_API_KEY=

# The App image. Empty means `personal-management-system-app:local`, which
# `docker compose build app` builds. For an image from a registry, use its full name, preferably
# with a commit tag. The image contains the Claude Code CLI, a proprietary Anthropic program, so
# the registry must be private.
APP_IMAGE=
# Production: the domains and the ACME contact for Caddy. They are not filled in locally: Caddy
# does not start.

APP_DOMAIN=
GBRAIN_DOMAIN=
ACME_EMAIL=
